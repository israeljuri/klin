{
  "name": "klin-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "experiment": "tsx src/experiment.ts",
    "coding-experiment": "tsx src/coding-experiment.ts",
    "pipeline:dry": "tsx src/run-pipeline.ts --dry-run",
    "pipeline:live": "KLIN_LIVE=1 tsx src/run-pipeline.ts",
    "project:parallel": "tsx src/run-project-parallel.ts",
    "project:plan": "KLIN_LIVE=1 tsx src/run-project-plan.ts",
    "test:unit": "tsx --test src/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
